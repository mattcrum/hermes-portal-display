# Voice bridge settings. ./setup.sh copies this to .env and fills in the keys. Never commit the real .env.

# --- Hermes -----------------------------------------------------------------
# Hermes Agent's API server (enable it in ~/.hermes/.env: API_SERVER_ENABLED=true, API_SERVER_KEY=...).
HERMES_URL=http://127.0.0.1:8642
# Same value as API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=

# --- Portal -----------------------------------------------------------------
# The key the Portal sends ("Authorization: Bearer ..."). Any long random string: openssl rand -hex 24
PORTAL_VOICE_KEY=

# --- Network ----------------------------------------------------------------
# 0.0.0.0  = reachable from your home network (Portal uses http://<this-machine's-ip>:8650)
# 127.0.0.1 = only through a reverse proxy on this machine (use this on a public server, with https)
BIND_HOST=0.0.0.0
BIND_PORT=8650

# --- Speech -----------------------------------------------------------------
# faster-whisper model: tiny | base | small  (base: about 1 s per question on 2 CPU cores)
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
# Any edge-tts voice: .venv/bin/edge-tts --list-voices
TTS_VOICE=en-US-AriaNeural

# --- Idle screen: clock + weather ---------------------------------------------
LOCAL_TZ=America/New_York
PLACE_NAME="New York"
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
# fahrenheit | celsius
WEATHER_UNITS=fahrenheit

# --- Idle screen: calendar (optional) ------------------------------------------
# auto  = show the agenda if Hermes has a Microsoft 365 MCP server named "ms365" in its config
# true / false = force it on or off
CALENDAR_ENABLED=auto
HERMES_CONFIG=~/.hermes/config.yaml
# Folder that holds npx, if it isn't on PATH for this service (Hermes ships its own node under ~/.hermes/tools/)
NODE_BIN=
